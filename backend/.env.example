# Copy this file to backend/.env and fill in real values.

# MongoDB connection string. Local:  mongodb://127.0.0.1:27017/marketplace
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/marketplace
# (URL-encode special characters in the password, e.g. @ -> %40)
MONGO_URI=mongodb://127.0.0.1:27017/marketplace

PORT=3000
HOST=http://localhost

# Long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
SESSION_SECRET=change-me

# Optional: Gmail address + App Password for order-confirmation emails.
# Leave blank to skip sending email.
EMAIL_USER=
EMAIL_PASS=

# Optional: not used by any route yet.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
