<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Delivery</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container mt-5">
    <h1 class="text-center">Order Delivery Status</h1>
    
    <% if (orderStatus) { %>
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Order Number: <%= orderStatus.orderNumber %></h5>
          <p class="card-text"><strong>Status:</strong> <%= orderStatus.status %></p>
          <p class="card-text"><strong>Expected Delivery:</strong> <%= orderStatus.deliveryDate %></p>
          <p class="card-text"><strong>Carrier:</strong> <%= orderStatus.carrier %></p>
          <p class="card-text"><strong>Location:</strong> <%= orderStatus.location %></p>

          <div class="mt-4">
            <a href="#" class="btn btn-primary">Buy Again</a>
            <a href="#" class="btn btn-warning">Return</a>
            <a href="#" class="btn btn-danger">Request Refund</a>
            <a href="#" class="btn btn-info">Track Shipment</a>
            <a href="/product-list" class="btn btn-outline-secondary">Back to Shop</a>
            </div>
        </div>
      </div>
    <% } else { %>
      <p class="text-center">No order found.</p>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
