<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Stock Listings</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/assets/css/product-list.css">
  <script src="/js/product-status.js" defer></script>
</head>
<body>
  <div class="container mt-5">
  <!-- Floating View as Buyer Button -->
    <div class="d-flex flex-wrap gap-2 mb-3">
      <a href="/buyer/homepage" class="btn btn-success">View as Buyer</a>
      <a href="/buyer/manage" class="btn btn-outline-secondary">View as Seller</a>
      <a href="/add-products" class="btn btn-primary">Add Product</a>
      <a href="/buyer/cart" class="btn btn-outline-primary">Cart</a>
      <a href="/buyer/trackorder" class="btn btn-primary">Track Order</a>
      <a href="/logout" class="btn btn-outline-danger ms-auto">Logout<% if (user) { %> (<%= user.email %>)<% } %></a>
    </div>


    <h1 class="text-center mb-4">Manage Your Listings</h1>

    <div class="row">
      <% products.forEach(product => { %>
      <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
        <div class="card product-card">
          <img src="<%= /^https?:\/\//.test(product.image || '') ? product.image : '/' + product.image %>" alt="<%= product.title %>" class="product-img" />
          <div class="card-body">
            <h5 class="card-title"><%= product.title %></h5>
            <p class="category text-muted"><%= product.category %></p>
            <p class="price">$<%= product.price.toFixed(2) %></p>
            <p class="rating">⭐ 4.5 / 5</p>
            <p class="small text-muted"><%= product.description %></p>
            <p class="fw-bold text-danger" id="status-text-<%= product._id %>"><%= product.status %></p>

            <!-- Status Dropdown & Button -->
            <div class="d-flex">
              <select id="status-<%= product._id %>" class="form-select me-2">
                <option value="Available" <%= product.status === 'Available' ? 'selected' : '' %>>Available</option>
                <option value="Sold" <%= product.status === 'Sold' ? 'selected' : '' %>>Sold</option>
                <option value="Out of Stock" <%= product.status === 'Out of Stock' ? 'selected' : '' %>>Out of Stock</option>
                <option value="Currently Not Available" <%= product.status === 'Currently Not Available' ? 'selected' : '' %>>Currently Not Available</option>
              </select>
              <button class="btn btn-primary update-status-btn" data-product-id="<%= product._id %>">Update</button>
            </div>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>

  <!-- footer.ejs -->
  <footer class="bg-dark text-white py-5">
    <div class="container">
      <div class="row">
        <!-- About Us -->
        <div class="col-lg-3 col-md-6 mb-3">
          <h5>About Us</h5>
          <ul class="list-unstyled">
            <li><a href="#" class="text-white">Company Info</a></li>
            <li><a href="#" class="text-white">Careers</a></li>
            <li><a href="#" class="text-white">Press Releases</a></li>
            <li><a href="#" class="text-white">Investor Relations</a></li>
          </ul>
        </div>

        <!-- Customer Service -->
        <div class="col-lg-3 col-md-6 mb-3">
          <h5>Customer Service</h5>
          <ul class="list-unstyled">
            <li><a href="#" class="text-white">Help Center</a></li>
            <li><a href="#" class="text-white">Returns & Refunds</a></li>
            <li><a href="#" class="text-white">Shipping Info</a></li>
            <li><a href="#" class="text-white">Order Tracking</a></li>
          </ul>
        </div>

        <!-- Quick Links -->
        <div class="col-lg-3 col-md-6 mb-3">
          <h5>Quick Links</h5>
          <ul class="list-unstyled">
            <li><a href="#" class="text-white">Your Account</a></li>
            <li><a href="#" class="text-white">Gift Cards</a></li>
            <li><a href="#" class="text-white">Affiliate Program</a></li>
            <li><a href="#" class="text-white">Terms & Conditions</a></li>
          </ul>
        </div>

        <!-- Follow Us -->
        <div class="col-lg-3 col-md-6 text-md-right text-center">
          <h5>Follow Us</h5>
          <a href="#" class="text-white me-3"><i class="fab fa-facebook-f"></i></a>
          <a href="#" class="text-white me-3"><i class="fab fa-instagram"></i></a>
          <a href="#" class="text-white me-3"><i class="fab fa-twitter"></i></a>
          <a href="#" class="text-white"><i class="fab fa-linkedin-in"></i></a>
        </div>
      </div>

      <!-- Bottom Section -->
      <div class="row mt-4">
        <div class="col-12 text-center">
          <p class="mb-0">© 2025 The innovators. All rights reserved.</p>
          <p><a href="#" class="text-white">Privacy Policy</a> | <a href="#" class="text-white">Terms of Service</a></p>
        </div>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>


