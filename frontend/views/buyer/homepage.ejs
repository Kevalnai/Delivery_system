<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View as Buyer</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css">
  <style>
    .product-img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }
  </style>
</head>
<body>
  <div class="container mt-5">
    <div class="d-flex flex-wrap gap-2 mb-3">
      <a href="/buyer/homepage" class="btn btn-success">View as Buyer</a>
      <a href="/buyer/manage" class="btn btn-outline-secondary">View as Seller</a>
      <a href="/add-products" class="btn btn-primary">Add Product</a>
      <a href="/buyer/cart" class="btn btn-outline-primary">Cart</a>
      <a href="/buyer/trackorder" class="btn btn-primary">Track Order</a>
      <a href="/logout" class="btn btn-outline-danger ms-auto">Logout<% if (user) { %> (<%= user.email %>)<% } %></a>
    </div>
    <h1 class="text-center">Shop the Best Deals</h1>
    
    <div class="row">
      <% if (!products || products.length === 0) { %>
        <p class="text-center text-muted">No products available.</p>
      <% } else { %>
        <% products.forEach(product => { %>
          <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
            <div class="card product-card">
              <img src="<%= /^https?:\/\//.test(product.image || '') ? product.image : '/' + product.image %>" alt="<%= product.title %>"
                  class="product-img">
              <div class="card-body">
                <h5 class="card-title"><%= product.title %></h5>
                <p class="category text-muted"><%= product.category %></p>
                <p class="price">$<%= (product.price || 0).toFixed(2) %></p>
                <p class="small text-muted"><%= product.description %></p>
                
                <!-- Add to Cart Form -->
                <form action="/buyer/add-to-cart" method="POST">
                  <input type="hidden" name="productId" value="<%= product._id %>">
                  <input type="number" name="quantity" min="1" max="99" value="1" class="form-control mb-2" required>
                  <button type="submit" class="btn btn-success">Add to Cart</button>
                </form>
              </div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
